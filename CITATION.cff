    given-names: Stephanie C.
    affiliation: Johns Hopkins University
version: 1.1.0
date-released: 2026-09-07
repository-code: https://github.com/tjchen020524/SpatioS2E
license: MIT
keywords:
  - spatial transcriptomics
  - virtual spatial transcriptomics
  - gene-conditioned prediction
  - component-resolved evaluation
  - target-disjoint evaluation
